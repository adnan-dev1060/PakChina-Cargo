# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API (the Vite frontend).
CORS_ORIGINS=http://localhost:5173

# MongoDB connection string (MongoDB Atlas or local), including the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pak-china-cargo?retryWrites=true&w=majority
MONGODB_URI=

# Only if you get "querySrv ECONNREFUSED": DNS servers used to look up mongodb+srv:// hosts.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Long random string (64+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies: keep "lax" when frontend and API share a site. Use "none" (+ HTTPS) if they are on different domains.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # defaults to true in production

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pak-china-cargo
MAX_UPLOAD_MB=5

# Public address of the website (sitemap, canonical links, link previews). Optional:
# when empty, the address the site is opened at is used. Example: https://pakchinacargo.com
SITE_URL=
# The server also serves the built website from this folder (relative to backend/) when it exists.
# WEB_DIST=../frontend/dist

# Used once by `npm run seed` to create the first admin account (remove afterwards).
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
