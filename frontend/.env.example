# Where the API is:
#   empty                  -> no backend; the site shows the bundled seed content
#   /                      -> API on the same server as the website (production / Render / VPS)
#   http://localhost:4000  -> separate API server (local development)
VITE_API_URL=
# Public site URL for canonical links. Optional: defaults to the address the site is opened at.
VITE_SITE_URL=
